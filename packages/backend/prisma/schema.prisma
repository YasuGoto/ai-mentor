datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/@prisma/client"
}

model Goal {
  id          Int      @id @default(autoincrement())
  userId      Int
  title       String
  description String?
  targetDate  DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], name: "UserGoals")
  chatMessages ChatMessage[]
  actionLogs   ActionLog[]
}

model User {
  id            Int      @id @default(autoincrement())
  name          String
  email         String   @unique
  password_hash String
  createdAt     DateTime @default(now())

  goals Goal[] @relation("UserGoals")
}

model ChatMessage {
  id        Int      @id @default(autoincrement())
  goalId    Int
  message   String
  createdAt DateTime @default(now())

  goal       Goal        @relation(fields: [goalId], references: [id])
  actionLogs ActionLog[]
}

model ActionLog {
  id            Int      @id @default(autoincrement())
  goalId        Int
  chatMessageId Int?
  content       String
  logDate       DateTime
  createdAt     DateTime @default(now())

  goal        Goal         @relation(fields: [goalId], references: [id])
  chatMessage ChatMessage? @relation(fields: [chatMessageId], references: [id])
}

enum GoalStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}
